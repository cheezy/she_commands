<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="w-full max-w-5xl mx-auto py-12">
    <div class="mb-6">
      <.link
        navigate={~p"/admin"}
        class="text-xs font-label uppercase tracking-[0.15em] text-base-content/60 hover:text-base-content transition"
      >
        &larr; {gettext("Back to Admin")}
      </.link>
    </div>
    <div class="mb-10">
      <p class="font-label text-xs uppercase tracking-[0.25em] text-base-content/50 mb-4">
        {gettext("Administration")}
      </p>
      <h1 class="text-3xl sm:text-4xl font-serif italic leading-[1.1] tracking-[-0.02em] text-base-content">
        {gettext("Users")}
      </h1>
      <p class="mt-4 text-sm text-base-content/60">
        {gettext("%{count} users", count: length(@users))}
      </p>
    </div>

    <div class="border border-base-300 bg-base-100">
      <table class="w-full text-sm">
        <thead class="bg-base-200 text-base-content">
          <tr>
            <th class="text-left font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Name")}
            </th>
            <th class="text-left font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Email")}
            </th>
            <th class="text-left font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Role")}
            </th>
            <th class="text-left font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Status")}
            </th>
            <th class="text-right font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Actions")}
            </th>
          </tr>
        </thead>
        <tbody>
          <%= for user <- @users do %>
            <tr class="border-t border-base-300">
              <td class="px-4 py-3 text-base-content font-medium">
                {display_name(user)}
              </td>
              <td class="px-4 py-3 text-base-content/60 font-mono text-xs">{user.email}</td>
              <td class="px-4 py-3">
                <%= if own_row?(user, @current_scope.user) do %>
                  <span class="text-base-content/60 text-xs uppercase tracking-[0.1em]">
                    {user.role}
                  </span>
                <% else %>
                  <form phx-change="update_role">
                    <input type="hidden" name="user_id" value={user.id} />
                    <select
                      name="role"
                      class="select select-sm bg-base-100 border border-base-300 text-base-content text-xs"
                    >
                      <%= for {label, value} <- role_options() do %>
                        <option value={value} selected={Atom.to_string(user.role) == value}>
                          {label}
                        </option>
                      <% end %>
                    </select>
                  </form>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <%= if user.disabled do %>
                  <span class="inline-block px-2 py-1 text-xs font-label uppercase tracking-[0.1em] bg-error/10 text-error border border-error/30">
                    {gettext("Disabled")}
                  </span>
                <% else %>
                  <span class="inline-block px-2 py-1 text-xs font-label uppercase tracking-[0.1em] bg-primary/10 text-primary border border-primary/30">
                    {gettext("Active")}
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= if own_row?(user, @current_scope.user) do %>
                  <span class="text-xs text-base-content/40 italic">
                    {gettext("(you)")}
                  </span>
                <% else %>
                  <button
                    phx-click="toggle_disabled"
                    phx-value-id={user.id}
                    class="text-xs font-label uppercase tracking-[0.15em] text-primary hover:opacity-70 transition cursor-pointer"
                  >
                    <%= if user.disabled do %>
                      {gettext("Enable")}
                    <% else %>
                      {gettext("Disable")}
                    <% end %>
                  </button>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</Layouts.app>
