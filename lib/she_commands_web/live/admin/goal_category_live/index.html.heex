<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="w-full max-w-5xl mx-auto">
    <div class="mb-6">
      <.link
        navigate={~p"/admin"}
        class="text-xs font-label uppercase tracking-[0.15em] text-base-content/60 hover:text-base-content transition"
      >
        &larr; {gettext("Back to Admin")}
      </.link>
    </div>
    <div class="mb-10 flex items-end justify-between gap-4">
      <div>
        <p class="font-label text-xs uppercase tracking-[0.25em] text-base-content/50 mb-4">
          {gettext("Administration")}
        </p>
        <h1 class="text-3xl sm:text-4xl font-serif italic leading-[1.1] tracking-[-0.02em] text-base-content">
          {gettext("Goal Categories")}
        </h1>
        <p class="mt-4 text-sm text-base-content/60">
          {gettext("%{count} categories", count: length(@categories))}
        </p>
      </div>
      <.link
        patch={~p"/admin/goal-categories/new"}
        class="shrink-0 py-3 px-8 bg-base-content text-base-100 text-xs font-label uppercase tracking-[0.2em] hover:bg-base-content/90 transition cursor-pointer"
      >
        {gettext("New category")}
      </.link>
    </div>

    <div class="border border-base-300 bg-base-100">
      <table class="w-full text-sm">
        <thead class="bg-base-200 text-base-content">
          <tr>
            <th class="text-left font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Position")}
            </th>
            <th class="text-left font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Name")}
            </th>
            <th class="text-left font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Slug")}
            </th>
            <th class="text-left font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Status")}
            </th>
            <th class="text-right font-label text-xs uppercase tracking-[0.15em] px-4 py-3">
              {gettext("Actions")}
            </th>
          </tr>
        </thead>
        <tbody>
          <%= for category <- @categories do %>
            <tr class="border-t border-base-300">
              <td class="px-4 py-3 text-base-content/70">{category.position}</td>
              <td class="px-4 py-3 text-base-content font-medium">{category.name}</td>
              <td class="px-4 py-3 text-base-content/60 font-mono text-xs">{category.slug}</td>
              <td class="px-4 py-3">
                <%= if category.visible_on_intake do %>
                  <span class="inline-block px-2 py-1 text-xs font-label uppercase tracking-[0.1em] bg-primary/10 text-primary border border-primary/30">
                    {gettext("Visible")}
                  </span>
                <% else %>
                  <span class="inline-block px-2 py-1 text-xs font-label uppercase tracking-[0.1em] bg-base-200 text-base-content/60 border border-base-300">
                    {gettext("Hidden")}
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <div class="flex justify-end gap-3">
                  <.link
                    patch={~p"/admin/goal-categories/#{category.id}/edit"}
                    class="text-xs font-label uppercase tracking-[0.15em] text-primary hover:opacity-70 transition cursor-pointer"
                  >
                    {gettext("Edit")}
                  </.link>
                  <button
                    phx-click="toggle"
                    phx-value-id={category.id}
                    class="text-xs font-label uppercase tracking-[0.15em] text-primary hover:opacity-70 transition cursor-pointer"
                  >
                    <%= if category.visible_on_intake do %>
                      {gettext("Hide")}
                    <% else %>
                      {gettext("Show")}
                    <% end %>
                  </button>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <.live_component
    :if={@live_action in [:edit, :new]}
    module={SheCommandsWeb.Admin.GoalCategoryLive.FormComponent}
    id="goal-category-form"
    category={@editing_category}
  />
</Layouts.app>
